// Prisma schema — Servicios Corporativos
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // "native" para desarrollo local; rhel-openssl-3.0.x para el runtime de Vercel
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Mensajes recibidos desde el formulario de contacto de la landing page.
model ContactMessage {
  id           String   @id @default(cuid())
  nombre       String
  correo       String
  telefono     String
  tipoServicio String
  mensaje      String
  estado       String   @default("nuevo") // nuevo | en_seguimiento | cerrado
  origen       String   @default("landing")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([estado])
}
